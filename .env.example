# ── Claudio 配置样例 ──
# 复制为 .env 后填写。真实 .env 不入库（见 .gitignore）。

# 服务端口
PORT=8080

# ── 网易云 API 实例（外部服务，自己起一个）──
NCM_BASE=http://localhost:3000
# 很多歌的直链需要登录 cookie；用 `npm run login:ncm` 扫码自动写入
NCM_COOKIE=
# 音质：standard/higher/exhigh(320k)/lossless(无损)/hires —— 无损/VIP 需会员登录
NCM_LEVEL=exhigh

# ── 大模型 ──
# 默认走已登录的 Codex/ChatGPT 订阅：无需 API key；模型、供应商和探索模式在网页右上角 ⚙ 设置。
# 默认 GPT-5.6 Luna + low；也可切 Terra / Sol / Grok 订阅 / Claude / DeepSeek。
# Grok：在设置里点「在浏览器中登录」，用 SuperGrok 或 X Premium+ 账号验证；登录态保存在本机 cache，无需 XAI_API_KEY。

# Claude Code 订阅通道（保留，续费后可在设置里直接切回）
CLAUDE_BIN=claude
# 模型：sonnet / haiku / opus
CLAUDE_MODEL=sonnet
# 扩展思考预算：默认 0 = 关思考（关键提速，实测 66s→7s）。写口播是创意任务不需深度推理；
# 想要更「用心」的编排可设 2000 之类，但首字延迟会显著变长。
CLAUDE_MAX_THINKING_TOKENS=0

# DeepSeek API 通道（保留）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ── TTS 提供方：默认 Fish，流式播放；失败会报错，不会自动回退 macOS say ──
TTS_PROVIDER=fish

# macOS say 仅保留为手工开发选项，不参与自动兜底
SAY_VOICE=Tingting

# Fish Audio（TTS_PROVIDER=fish 时必填）
FISH_API_KEY=
# 默认/兜底音色
FISH_REFERENCE_ID=
# 中文口播音色（口播已固定中文女声念）；EN 为将来多语言口播预留
FISH_VOICE_ZH=
FISH_VOICE_EN=
# 模型：s1（更轻快）/ s2-pro（官方当前推荐，音质与能力更完整）
FISH_MODEL=s1

# ── 节律调度（默认关，只手动触发）：=1 才开 07:00 规划 / 09:00 早间 / 整点情绪 ──
SCHEDULER_ENABLED=0

# ── 天气（注入选歌 prompt + 启动行显示）：留空 = 按本机出口 IP 自动定位 ──
WEATHER_CITY=
