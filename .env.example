# ── Claudio 配置样例 ──
# 复制为 .env 后填写。真实 .env 不入库（见 .gitignore）。

# 服务端口
PORT=8080

# ── 网易云 API 实例（外部服务，自己起一个）──
NCM_BASE=http://localhost:3000
# 很多歌的直链需要登录 cookie；用 `npm run login:ncm` 扫码自动写入
NCM_COOKIE=
# 音质：standard/higher/exhigh(320k)/lossless(无损)/hires —— 无损/VIP 需会员登录
NCM_LEVEL=exhigh
# 后台搜索之间至少隔多少毫秒（点歌不排队）；0 = 不排队
# NCM_SEARCH_GAP_MS=1500
# 任意 60 秒内后台最多发几个搜索（点歌也计数，但不被挡）；0 = 不限
# NCM_SEARCH_PER_MIN=6
# 盒子上几个实例共用网易云名额（合起来每分钟不超过 NCM_SEARCH_PER_MIN）。老板实例开一个只听本机的名额服务；
# 别的实例（公用版）填 NCM_SHARED_URL 来要名额，最多用到「上限 − NCM_SHARED_RESERVE」（点歌也算）。服务不通就按本实例上限照搜。
# NCM_SHARED_SERVE=127.0.0.1:8099
# NCM_SHARED_URL=http://127.0.0.1:8099
# NCM_SHARED_RESERVE=2

# ── 大模型 ──
# 三选一，在设置里切：本地 OpenAI 兼容服务（默认）/ Claude 订阅 / DeepSeek 官方。失败会报错，不自动切换。

# Claude Code 订阅：用本机已登录的 claude 命令，关思考、关工具
CLAUDE_BIN=claude
# 模型：sonnet / opus
CLAUDE_MODEL=sonnet

# DeepSeek 官方 API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ── 语音：默认 5090 台式机上的 Fish S2-Pro，Fish 云端手动备用；失败会报错，不自动切换 ──
# WSL 节点在外走中继、慢且断，默认经 Windows 节点开 ssh 隧道到 WSL 上的服务；TUNNEL_HOST 留空就直连 BASE_URL
# 语音档按需加载，不通时经 JUMP_HOST 跳到 SSH_HOST 让 gpuctl 拉起（需要本机 ~/.ssh/config 里有这些主机名、免密登录）
# PC5090_TTS_BASE_URL=http://127.0.0.1:18081
# PC5090_TTS_VOICE=claudio
# PC5090_TUNNEL_HOST=<Windows 节点的 ssh 别名>
# PC5090_TUNNEL_TARGET=<WSL 上语音服务的 IP:端口>
# PC5090_SSH_HOST=<能跑 gpuctl 的 ssh 别名>
# PC5090_JUMP_HOST=<跳板 ssh 别名，可留空>
# 装在 5090 的 Windows 本机时：PC5090_TTS_BASE_URL=http://<WSL IP>:8080、PC5090_TUNNEL_HOST= 留空、PC5090_GPUCTL=wsl
# PC5090_GPUCTL=ssh

# macOS say 仅保留为手工开发选项，不参与自动兜底
SAY_VOICE=Tingting

# Fish Audio 云端（设置里选 Fish 时必填）
FISH_API_KEY=
# 默认/兜底音色
FISH_REFERENCE_ID=
# 中文口播音色（口播已固定中文女声念）；EN 为将来多语言口播预留
FISH_VOICE_ZH=
FISH_VOICE_EN=
# 模型：s1（更轻快）/ s2-pro（官方当前推荐，音质与能力更完整）
FISH_MODEL=s1

# ── 节律调度（默认关，只手动触发）：=1 才开 07:00 规划 / 09:00 早间 / 整点情绪 ──
SCHEDULER_ENABLED=0

# ── 天气（注入选歌 prompt + 启动行显示）：留空 = 按本机出口 IP 自动定位 ──
WEATHER_CITY=

# ── 本地大模型（OpenAI 兼容接口；地址和 key 也可直接在设置页填，存本机 cache/）
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8001/v1
LOCAL_LLM_API_KEY=

# ── 语音点歌的转写服务（OpenAI 兼容 /v1/audio/transcriptions）；留空 = 不用 ──
# ASR_BASE_URL=
# ASR_FAST_URL=

# ── 家里其他设备点歌（/api/remote/*）额外放行的来源 IP，逗号分隔；本机默认放行 ──
# REMOTE_ALLOW=

# ── 场景提示里的个人作息补充（只放本地 .env，不进仓库）；留空就不提 ──
# SCENE_SUNDAY_EVENING_NOTE=周日晚上，通常要出门
# SCENE_FRIDAY_EVENING_NOTE=周五下班，通常回家
# 「我在 X」算上班的额外地点（默认认单位 / 公司 / 办公室），逗号分隔
# SCENE_WORK_PLACES=
