# 复制成 ~/stacks/claudio-public/secret.env（chmod 600）。真值不进仓库。
# hub 地址（新盒子局域网）和一把只有 claudio-invite scope 的服务 key
PUBLIC_HUB_BASE=http://hub.example.internal:9000
PUBLIC_HUB_KEY=
# 32 字节随机数（openssl rand -hex 32），加密朋友的网易云 cookie
PUBLIC_VAULT_KEY=
# Cloudflare Turnstile 的 secret（申请页人机校验）；留空 = 不校验，只适合内网自测
PUBLIC_TURNSTILE_SECRET=
PUBLIC_TURNSTILE_SITEKEY=
# 申请页所在站点（跨域提交）
PUBLIC_APPLY_ORIGINS=https://www.example.com
# 全站同时在播上限
PUBLIC_MAX_LISTENERS=8
# 老板实例的网易云搜索名额服务（两个实例同一出口，搜索名额合着算；老板优先）
NCM_SHARED_URL=http://127.0.0.1:8099
