{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claudio",
  "version": "0.1.0",
  "identifier": "com.claudio.fm",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Claudio",
        "url": "boot.html",
        "width": 440,
        "height": 760,
        "minWidth": 300,
        "minHeight": 92,
        "resizable": true,
        "alwaysOnTop": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "resources": {
      "../runtime/": "runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
