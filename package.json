{
  "name": "claudio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "claudio": "bin/claudio.mjs"
  },
  "description": "个人 AI 电台 — ChatGPT / Grok / Claude / DeepSeek 当 DJ 大脑，理解口味并挖掘小众音乐",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:desktop": "npm run runtime:prepare && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:all": "npm test && npm run test:desktop",
    "dev": "node server/index.js",
    "start": "node server/index.js",
    "ncm": "npx --yes NeteaseCloudMusicApi",
    "spike:tts": "node scripts/spike-tts.mjs",
    "login:ncm": "node scripts/ncm-login.mjs",
    "tauri": "cargo tauri",
    "tauri:dev": "cargo tauri dev",
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "tauri:build": "npm run runtime:prepare && cargo tauri build",
    "app:install": "npm run tauri:build && node scripts/install-app.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "NeteaseCloudMusicApi": "4.32.0",
    "ws": "^8.18.0"
  }
}
